{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JsonMorph": {
    "DataRoot": "data",
    "ApiKey": null,
    "MaxConcurrentJobs": 2,
    "MaxBatchSize": 5000,
    "MaxMemoryRecords": 10000,
    "AllowedHttpHosts": [ "localhost", "127.0.0.1" ]
  }
}
